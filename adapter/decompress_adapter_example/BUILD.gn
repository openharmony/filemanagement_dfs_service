import("//build/ohos.gni")
import("//foundation/filemanagement/dfs_service/distributedfile.gni")

group("decompress_adapter_example_target") {
  deps = []
  if (!dfs_service_feature_enable_cloud_adapter) {
    deps += [
      "${distributedfile_path}/adapter/decompress_adapter_example:decompress_adapter",
    ]
  }
}

config("public_config") {
  include_dirs = [
    "${distributedfile_path}/adapter/decompress_adapter_example/include",
  ]
}

config("optimize-size") {
  cflags = [
    "-fdata-sections",
    "-ffunction-sections",
    "-Oz",
  ]
  cflags_cc = [
    "-fvisibility-inlines-hidden",
    "-Oz",
  ]
}

ohos_shared_library("decompress_adapter") {
  version_script = "decompress_adapter.map"
  branch_protector_ret = "pac_ret"
  configs = [ ":optimize-size" ]
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
  }
  sources = [
    "${distributedfile_path}/adapter/decompress_adapter_example/src/decompress_kit_impl.cpp",
  ]

  public_configs = [ ":public_config" ]

  deps = [
    "${innerkits_native_path}/decompress_kit_inner:decompress_kit",
  ]

  external_deps = [
    "c_utils:utils",
  ]

  part_name = "dfs_service"
  subsystem_name = "filemanagement"
}
