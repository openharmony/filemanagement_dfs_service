import("//build/ohos.gni")
import("//foundation/filemanagement/dfs_service/distributedfile.gni")

config("public_config") {
  include_dirs = [ "." ]
}

config("private_config") {
  include_dirs = [
    "${distributedfile_path}/frameworks/native/decompress_kit_inner/include",
    "${distributedfile_path}/utils/decompress/include",
    "${distributedfile_path}/utils/log/include",
    "${distributedfile_path}/utils/inner_api",
  ]
}

config("optimize-size") {
  cflags = [
    "-fdata-sections",
    "-ffunction-sections",
    "-Oz",
  ]
  cflags_cc = [
    "-fvisibility-inlines-hidden",
    "-Oz",
  ]
}

ohos_shared_library("decompress_kit") {
  version_script = "decompress_kit.map"
  branch_protector_ret = "pac_ret"
  configs = [ ":optimize-size" ]
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
  }
  sources = [
    "${distributedfile_path}/frameworks/native/decompress_kit_inner/src/decompress_kit.cpp",
  ]

  defines = [
    "LOG_DOMAIN=0xD004311",
    "LOG_TAG=\"DECOMPRESS_KIT\"",
  ]

  configs += [ ":private_config" ]
  public_configs = [ ":public_config" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  deps = [ "${utils_path}:libdecompress" ]

  innerapi_tags = [ "platformsdk" ]
  part_name = "dfs_service"
  subsystem_name = "filemanagement"
}

ohos_static_library("decompress_kit_static") {
  testonly = true
  branch_protector_ret = "pac_ret"
  configs = [ ":optimize-size" ]
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
  }
  sources = [
    "${distributedfile_path}/frameworks/native/decompress_kit_inner/src/decompress_kit.cpp",
  ]

  defines = [
    "LOG_DOMAIN=0xD004311",
    "LOG_TAG=\"DECOMPRESS_KIT\"",
  ]

  configs += [ ":private_config" ]
  public_configs = [ ":public_config" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  deps = [ "${utils_path}:libdecompress" ]

  part_name = "dfs_service"
  subsystem_name = "filemanagement"
}
